# Supabase — Werte kommen aus dem Supabase-Dashboard.
# Diese Datei ist eine Vorlage. Echte Werte gehören nach .env.local und NIE ins Repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig verwenden — niemals in Client-Code importieren.
SUPABASE_SERVICE_ROLE_KEY=

# Discord OAuth (im Supabase-Dashboard hinterlegt, hier nur zur Dokumentation)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
