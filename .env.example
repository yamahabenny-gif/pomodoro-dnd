# Supabase — Werte kommen aus dem Supabase-Dashboard.
# Diese Datei ist eine Vorlage. Echte Werte gehören nach .env.local bzw. in die Hostinger-Umgebung und NIE ins Repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig verwenden — niemals in Client-Code importieren.
SUPABASE_SERVICE_ROLE_KEY=

# Discord OAuth (im Supabase-Dashboard hinterlegt, hier nur zur Dokumentation)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Lokal bleibt localhost der Default.
# Interner Hostinger-Teststand: NEXT_PUBLIC_SITE_URL=<vom Webdesigner bereitgestellte Test-URL>
# Produktion später: NEXT_PUBLIC_SITE_URL=https://focus.lang-jamin.de
# Beide Werte werden ausschließlich in der jeweiligen Deployment-Umgebung gesetzt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
